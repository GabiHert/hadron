{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hadron.app/schemas/manifest.json",
  "title": "Hadron integration or script manifest",
  "type": "object",
  "required": ["name", "version"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "The integration id, which is also the field namespace (jira.status)."},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "fields": {
      "type": "array",
      "description": "Fields the integration contributes. Names have no namespace; the app prefixes them with the integration id.",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string"},
          "type": {"enum": ["text", "number", "enum", "user", "date", "bool"]},
          "options": {"type": "array", "items": {"type": "string"}},
          "filterable": {"type": "boolean"},
          "editable": {"type": "boolean"},
          "card_chip": {"type": "boolean"}
        }
      }
    },
    "ops": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": {"$ref": "#/$defs/op"},
        "get": {"$ref": "#/$defs/op"},
        "update": {"$ref": "#/$defs/op"},
        "poll": {"$ref": "#/$defs/op"},
        "actions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"}, "additionalProperties": {"$ref": "#/$defs/op"}},
        "queries": {"type": "object", "description": "Named dashboard queries. ops.queries.<name> takes the block's args and returns {groups: [{key, label, count}], ttl_s?}; the app registers <integration>.<name> and caches the result.", "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"}, "additionalProperties": {"$ref": "#/$defs/op"}},
        "sessions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "list": {"$ref": "#/$defs/op"},
            "output": {"$ref": "#/$defs/op"},
            "send": {"$ref": "#/$defs/op"},
            "start": {"$ref": "#/$defs/op"},
            "stop": {"$ref": "#/$defs/op"}
          }
        }
      }
    },
    "config": {
      "type": "object",
      "description": "Settings the user fills in. Read by the code as host.config.<key>.",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["string", "number", "bool"]},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "required": {"type": "boolean"},
          "default": {}
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "URL patterns http.request may call, such as https://*.atlassian.net/*, or mcp:<server> for mcp.call."},
        "secrets": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"}},
        "api": {"type": "array", "items": {"enum": ["link.upsert", "link.list", "field.set", "card.read", "card.move", "card.list", "session.list_remote", "notify"]}},
        "exec": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}}
      }
    },
    "poll_seconds": {"type": "integer", "minimum": 0},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "op": {"type": "string"},
          "input": {},
          "config": {"type": "object"},
          "http_fixtures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url"],
              "additionalProperties": false,
              "properties": {
                "method": {"type": "string"},
                "url": {"type": "string"},
                "status": {"type": "integer"},
                "headers": {"type": "object"},
                "json": {},
                "text": {"type": "string"}
              }
            }
          },
          "exec_fixtures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["binary"],
              "additionalProperties": false,
              "properties": {
                "binary": {"type": "string"},
                "args": {"type": "array", "items": {"type": "string"}},
                "stdout": {"type": "string"},
                "stderr": {"type": "string"},
                "code": {"type": "integer"}
              }
            }
          },
          "mcp_fixtures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["server", "tool"],
              "additionalProperties": false,
              "properties": {"server": {"type": "string"}, "tool": {"type": "string"}, "result": {}}
            }
          },
          "expect": {"description": "Every key given here must equal the op's output; extra keys in the output are fine."}
        }
      }
    }
  },
  "$defs": {
    "op": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "input": {"type": ["object", "boolean"], "description": "A JSON Schema for the input. The op's default applies when absent."},
        "output": {"type": ["object", "boolean"], "description": "A JSON Schema for the output."}
      }
    }
  }
}
